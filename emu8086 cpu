org 100h

start:
    mov ax, 0x0040  
    mov ds, ax
    mov al, [0x0013] 

   
    mov dx, offset msg
    mov ah, 09h
    int 21h

   
    mov ah, 0
    mov bl, al
    call print_hex_byte

    
    mov ax, 4c00h
    int 21h

я
print_hex_byte:
    push ax
    push bx
    mov ah, 0Eh    
    mov al, bl
    shr al, 4
    call print_nibble
    mov al, bl
    and al, 0Fh
    call print_nibble
    pop bx
    pop ax
    ret

print_nibble:
    cmp al, 9
    jbe digit
    add al, 7
digit:
    add al, '0'
    int 10h
    ret

msg db 'CPU type code in BIOS data area: $'
